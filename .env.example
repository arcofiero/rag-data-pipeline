# Confluent Cloud / Kafka
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_SCHEMA_REGISTRY_URL=
KAFKA_SCHEMA_REGISTRY_API_KEY=
KAFKA_SCHEMA_REGISTRY_API_SECRET=

# AWS / S3 / Delta Lake
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
DELTA_BRONZE_PATH=s3a://<bucket>/delta/bronze
DELTA_SILVER_PATH=s3a://<bucket>/delta/silver
DELTA_GOLD_PATH=s3a://<bucket>/delta/gold

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Pinecone
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# Kafka Topics
TOPIC_RAW_DOCUMENTS=raw-documents
TOPIC_DLQ=raw-documents-dlq

# Soda Core
SODA_CLOUD_API_KEY=

# OpenLineage
OPENLINEAGE_URL=
OPENLINEAGE_API_KEY=

# Airflow
AIRFLOW_FERNET_KEY=

# Confluent Schema Registry
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.aws.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_API_KEY=your_sr_api_key
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=your_sr_api_secret

# Topic config
KAFKA_NUM_PARTITIONS=6
MALFORMED_EVENT_RATE=0.05

# Streaming / Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_OFFSETS_PER_TRIGGER=5000
SPARK_CHECKPOINT_PATH=s3a://<bucket>/delta/bronze_checkpoint
DELTA_BRONZE_DLQ_PATH=s3a://<bucket>/delta/bronze_dlq

# Silver quality thresholds
SILVER_MIN_WORD_COUNT=10
SILVER_MIN_CHAR_COUNT=50

# Embedding pipeline
EMBED_BATCH_SIZE=512
PINECONE_BATCH_SIZE=100
EMBEDDING_FRESHNESS_HOURS=24

RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=20000
RAG_MAX_QUERY_CHARS=1000

# OpenLineage (optional — emitter no-ops if not set)
OPENLINEAGE_NAMESPACE=rag-pipeline
PIPELINE_VERSION=1.0.0

# Local Delta Lake paths (used when not running on S3)
DELTA_BRONZE_PATH=/tmp/rag-delta/bronze
DELTA_SILVER_PATH=/tmp/rag-delta/silver
DELTA_GOLD_PATH=/tmp/rag-delta/gold
SPARK_CHECKPOINT_PATH=/tmp/rag-delta/bronze_checkpoint
DELTA_BRONZE_DLQ_PATH=/tmp/rag-delta/bronze_dlq

# Smoke test
FASTAPI_URL=http://localhost:8000
SMOKE_TEST_EVENTS=10
